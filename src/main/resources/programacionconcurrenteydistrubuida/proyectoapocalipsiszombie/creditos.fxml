<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane prefHeight="600.0" prefWidth="800.0"
            xmlns="http://javafx.com/javafx/8"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="programacionconcurrenteydistrubuida.proyectoapocalipsiszombie.Controlador.CreditosController">
   <children>

      <!-- Contenedor para centrar el texto -->
      <StackPane prefWidth="800.0" prefHeight="600.0">
         <Text text="Juego realizado por Raúl Muñoz Yélamos y Adrián Arana Peña"
               wrappingWidth="600"
               textAlignment="CENTER"
               style="-fx-font-size: 20px; -fx-font-family: 'Segoe UI Semibold'; -fx-fill: #2b2b2b;"/>
      </StackPane>

      <!-- Botón volver en la parte inferior izquierda -->
      <Button fx:id="VolverButton"
              AnchorPane.leftAnchor="0.0" AnchorPane.bottomAnchor="0.0"
              mnemonicParsing="false"
              onAction="#onVolverButtonClick"
              text="Volver"
              style="-fx-font-size: 14px;"/>

   </children>
</AnchorPane>
