<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.StackPane?>

<AnchorPane prefHeight="600.0" prefWidth="800.0"
            xmlns="http://javafx.com/javafx/17.0.6"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="programacionconcurrenteydistrubuida.proyectoapocalipsiszombie.Controlador.VentanaPrincipalController">

   <children>
      <StackPane prefWidth="800.0" prefHeight="600.0">
         <Button fx:id="botonIniciar"
                 text="COMENZAR APOCALIPSIS..."
                 onAction="#botonIniciarClick"
                 prefWidth="300.0"
                 prefHeight="40.0"
                 style="-fx-font-size: 16px;"/>
      </StackPane>
   </children>
</AnchorPane>
